# ---------------------------------------------------------------------------
# Protection Tax — AI Blog Generator configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Google Gemini (blog content) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Hugging Face (featured image generation) ---
HF_API_TOKEN=your-huggingface-token
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- WordPress (protectiontax.com) ---
# Use an Application Password (Users > Profile > Application Passwords).
WP_BASE_URL=https://protectiontax.com
WP_USERNAME=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Publish status: "publish", "draft", "pending", or "future"
WP_POST_STATUS=draft
# Optional: comma-separated WordPress category IDs to assign to each post
WP_CATEGORY_IDS=

# --- Scheduling ---
# Cron expression for when to publish (server local time). Default: Mon & Thu 9am.
POST_CRON=0 9 * * 1,4
# Timezone for the schedule (IANA name)
SCHEDULE_TIMEZONE=America/Los_Angeles
